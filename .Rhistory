library(segmented)
#model data
library(segmented)
lin.mod <- lm(y~x)
segmented.mod <- segmented(lin.mod, seg.Z = ~x, psi=60)
x <- c(1:50, 61:70)
y <- numeric(60)
#create first segment
y[1:50] <- seq(20, 11, len=50) + rnorm(50, 0, 2)
#create second segment
y[51:60] <- seq(11, 15, len=10) + rnorm(10, 0, 2)
#plot points
par(mar=c(4,4,1,1)+0.2)
plot(x,y, pch=16)
#model data
library(segmented)
lin.mod <- lm(y~x)
segmented.mod <- segmented(lin.mod, seg.Z = ~x, psi=60)
#create empty data set
new_data <- data.frame(x = seq(min(x), max(x), length.out = 100))
View(new_data)
#fill with model predictions
preds <- predict.segmented(segmented.mod, newdata = new_data, type = "link", se.fit = TRUE)
#get 95% CI
new_data$lwr <- preds$fit - (1.96 * preds$se.fit)
new_data$upr <- preds$fit + (1.96 * preds$se.fit)
plot(x,y, pch=16)
plot(segmented.mod,add=T)
lines(new_data$lwr ~ new_data$x, col = "red", lty = 2)
lines(new_data$upr ~ new_data$x, col = "red", lty = 2)
